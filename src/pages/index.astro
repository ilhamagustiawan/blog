---
import HomeSection from '../components/home/HomeSection.astro';
import PostList from '../components/home/PostList.astro';
import { getLatestPosts } from '../data/content';
import { getSiteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const POST_COUNT = 10;

const { home, site } = await getSiteConfig();
const posts = await getLatestPosts(POST_COUNT);

// Only plain links; copy-to-clipboard entries belong to the old dashboard
const links = home.links.filter((link) => link.tooltip && !link.copy);
---

<BaseLayout title={site.pageTitle} description={site.pageDescription}>
  <main class="home">
    <h1>{home.intro.title}</h1>
    {home.intro.body.map((line) => <p>{line}</p>)}

    {
      links.length > 0 && (
        <p class="find-me">
          Find me on{' '}
          {links.map((link, index) => (
            <>
              <a href={link.tooltip}>{link.label}</a>
              {index < links.length - 1 && ', '}
            </>
          ))}
        </p>
      )
    }

    <HomeSection title="Writing" href="/blog/">
      <PostList posts={posts} />
    </HomeSection>
  </main>
</BaseLayout>

<style>
  .home {
    width: min(100%, 680px);
  }

  h1 {
    margin: 0 0 16px;
    font-size: 1.5rem;
    font-weight: 700;
  }

  p {
    margin: 0 0 8px;
    color: var(--paper-ink-soft);
  }

  .find-me a {
    color: var(--paper-ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .find-me a:hover {
    color: var(--paper-accent);
  }
</style>
