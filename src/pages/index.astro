---
import Icon from '../components/Icon.astro';
import HomeSection from '../components/home/HomeSection.astro';
import PostList from '../components/home/PostList.astro';
import { getLatestPosts } from '../data/content';
import { getSiteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const POST_COUNT = 10;
const LINK_ICON_SIZE = 20;

const { home, site } = await getSiteConfig();
const posts = await getLatestPosts(POST_COUNT);

// Only plain links; copy-to-clipboard entries belong to the old dashboard
const links = home.links.filter((link) => link.tooltip && !link.copy);
---

<BaseLayout title={site.pageTitle} description={site.pageDescription}>
  <main class="home">
    <!-- Name already shows in the header; keep h1 for screen readers -->
    <h1 class="sr-only">{home.intro.title}</h1>
    {home.intro.body.map((line) => <p>{line}</p>)}

    {
      links.length > 0 && (
        <nav class="find-me" aria-label="Find me on">
          {links.map((link) => (
            <a href={link.tooltip} aria-label={link.label} title={link.label}>
              <Icon name={link.icon} size={LINK_ICON_SIZE} />
            </a>
          ))}
        </nav>
      )
    }

    <HomeSection title="Writing" href="/blog/">
      <PostList posts={posts} />
    </HomeSection>
  </main>
</BaseLayout>

<style>
  /* Same 680px text column as the header; main adds side gutters */
  .home {
    width: min(100%, calc(680px + 2 * var(--layout-page-gutter)));
  }

  p {
    margin: 0 0 8px;
    color: var(--paper-ink-soft);
  }

  /* Icon row: GitHub, Instagram, RSS */
  .find-me {
    display: flex;
    gap: 16px;
    margin-top: 12px;
  }

  .find-me a {
    display: inline-flex;
    color: var(--paper-ink-soft);
  }

  .find-me a:hover {
    color: var(--paper-accent);
  }
</style>
