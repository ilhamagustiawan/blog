---
import { getSiteConfig } from '../data/site';

const { site } = await getSiteConfig();
const year = new Date().getFullYear();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Stacked small links in the header column (stevedylan.dev) -->
<footer class="site-footer" data-pagefind-ignore>
  <a href={`${basePath}/`}>&copy; {year} {site.title}</a>
  <a href={`${basePath}/rss.xml`}>RSS</a>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: min(calc(100% - 32px), var(--layout-column, 768px));
    margin: 0 auto;
    padding: 80px 0 48px;
    color: var(--paper-ink-soft);
    font-size: 0.75rem;
    line-height: 1.33;
  }

  .site-footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .site-footer a:hover {
    color: var(--paper-accent);
  }

  @media (max-width: 720px) {
    .site-footer {
      width: calc(100% - 36px);
    }
  }
</style>
