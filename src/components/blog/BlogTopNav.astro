---
import { ListTree, Menu, Moon, Sun } from 'lucide-astro';
import SiteSearch from './SiteSearch.astro';
import TocTree from './TocTree.astro';
import { getRouteLabels, getSiteConfig, getTopNavLinks } from '../../data/site';
import { getUiText } from '../../utils/ui-text';
import type { TocItem } from '../../utils/toc-tree';

interface Props {
  showTocIcon?: boolean;
  tocItems?: TocItem[];
}

const { showTocIcon = false, tocItems = [] } = Astro.props;
const siteConfig = await getSiteConfig();
const { site, search } = siteConfig;
const ui = getUiText(siteConfig);
const links = await getTopNavLinks();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPathname =
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;
const currentPath = currentPathname.replace(/\/$/, '') || '/';

function withBase(href: string) {
  if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
    return href;
  }

  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}

function isActive(href: string) {
  if (href.startsWith('http')) return false;

  const normalizedHref = href.replace(/\/$/, '') || '/';

  if (normalizedHref === '/') {
    return currentPath === '/';
  }

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}

const routeLabels = getRouteLabels();
const activeRoute = Object.entries(routeLabels).find(
  ([route]) => currentPath === route || currentPath.startsWith(`${route}/`),
);
const brandRouteLabel = activeRoute?.[1];
const shouldShowTocAction = showTocIcon && tocItems.length > 0;
---

<header
  class="blog-top-nav"
  data-pagefind-ignore
  data-toc-open-label={ui.toc.open}
  data-toc-close-label={ui.toc.close}
>
  <button
    class="mobile-menu-toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-nav-menu"
    data-mobile-menu-toggle
  >
    <Menu size={18} stroke-width={2} />
  </button>

  <a class="brand" href={withBase('/')} aria-label={`Go to ${site.title} home`}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-title">
      <span>{site.title}</span>
      {brandRouteLabel && <span class="brand-route"> · {brandRouteLabel}</span>}
    </span>
  </a>

  <nav class="nav-links" aria-label="Article navigation">
    {
      links.map((link) =>
        link.disabled ? (
          <span
            class="nav-link nav-link-placeholder"
            aria-disabled="true"
            title="Projects content placeholder"
          >
            {link.label}
          </span>
        ) : (
          <a class:list={['nav-link', { active: isActive(link.href) }]} href={withBase(link.href)}>
            /{link.label}
          </a>
        ),
      )
    }
  </nav>

  <nav
    class="mobile-menu-panel"
    id="mobile-nav-menu"
    aria-label="Mobile navigation"
    data-mobile-menu
  >
    {
      links.map((link) =>
        link.disabled ? (
          <span class="mobile-menu-link mobile-menu-placeholder" aria-disabled="true">
            {link.label}
          </span>
        ) : (
          <a
            class:list={['mobile-menu-link', { active: isActive(link.href) }]}
            href={withBase(link.href)}
            data-mobile-menu-link
          >
            {link.label}
          </a>
        ),
      )
    }
  </nav>

  <div class="nav-actions" aria-label="Page actions">
    <button type="button" data-theme-toggle aria-label="Switch theme">
      <Moon class="theme-icon-moon" size={17} stroke-width={2} />
      <Sun class="theme-icon-sun" size={17} stroke-width={2} />
    </button>
    {search.enabled && <SiteSearch search={search} />}
    {
      shouldShowTocAction && (
        <button
          class="toc-action"
          type="button"
          aria-label={ui.toc.open}
          aria-expanded="false"
          aria-controls="mobile-toc-menu"
          title={ui.toc.title}
          data-mobile-toc-trigger
        >
          <ListTree size={17} stroke-width={2} />
        </button>
      )
    }
  </div>

  {
    shouldShowTocAction && (
      <nav
        class="mobile-toc-panel"
        id="mobile-toc-menu"
        aria-label={ui.toc.title}
        data-nav-toc-menu
        data-toc-root
        data-toc-scroll
      >
        <p>{ui.toc.title}</p>
        <TocTree items={tocItems} idPrefix="nav-toc" navLink />
      </nav>
    )
  }
</header>

<script>
  let navigationSequence = 0;
  let activeNavigationId = 0;

  const clearPendingNavigation = (navigationId?: number) => {
    if (navigationId && navigationId !== activeNavigationId) {
      return;
    }

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      delete header.dataset.navPending;
      header.removeAttribute('aria-busy');

      for (const link of header.querySelectorAll<HTMLElement>('[data-nav-link-pending]')) {
        delete link.dataset.navLinkPending;
      }
    }

    activeNavigationId = 0;
  };

  const startPendingNavigation = (sourceElement?: Element) => {
    const sourceLink = sourceElement?.closest<HTMLAnchorElement>('.blog-top-nav a[href]');

    if (!sourceLink) {
      return 0;
    }

    const navigationId = ++navigationSequence;
    const pendingHref = sourceLink.href;
    activeNavigationId = navigationId;

    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      header.dataset.navPending = 'true';
      header.setAttribute('aria-busy', 'true');

      for (const link of header.querySelectorAll<HTMLAnchorElement>('a[href]')) {
        link.toggleAttribute('data-nav-link-pending', link.href === pendingHref);
      }
    }

    return navigationId;
  };

  const initMobileTopNav = () => {
    for (const header of document.querySelectorAll<HTMLElement>('.blog-top-nav')) {
      const toggle = header.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
      const tocTrigger = header.querySelector<HTMLButtonElement>('[data-mobile-toc-trigger]');
      const tocMenu = header.querySelector<HTMLElement>('[data-nav-toc-menu]');

      if (toggle && menu && !header.dataset.mobileMenuReady) {
        header.dataset.mobileMenuReady = 'true';

        const setMenuOpen = (open: boolean) => {
          header.dataset.mobileMenuOpen = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute(
            'aria-label',
            open ? 'Close navigation menu' : 'Open navigation menu',
          );
        };
        const setTocOpen = (open: boolean) => {
          if (!tocTrigger || !tocMenu) {
            return;
          }

          const tocOpenLabel = header.dataset.tocOpenLabel ?? 'Open table of contents';
          const tocCloseLabel = header.dataset.tocCloseLabel ?? 'Close table of contents';

          header.dataset.mobileTocOpen = open ? 'true' : 'false';
          tocTrigger.setAttribute('aria-expanded', String(open));
          tocTrigger.setAttribute('aria-label', open ? tocCloseLabel : tocOpenLabel);
        };

        toggle.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileMenuOpen !== 'true';
          setMenuOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setTocOpen(false);
          }
        });

        menu.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-mobile-menu-link]')) {
            setMenuOpen(false);
          }
        });

        tocTrigger?.addEventListener('click', () => {
          const nextOpen = header.dataset.mobileTocOpen !== 'true';
          setTocOpen(nextOpen);
          header.dataset.navHidden = 'false';
          if (nextOpen) {
            setMenuOpen(false);
          }
        });

        tocMenu?.addEventListener('click', (event) => {
          if ((event.target as Element).closest?.('[data-nav-toc-link]')) {
            setTocOpen(false);
          }
        });

        document.addEventListener('click', (event) => {
          if (!header.contains(event.target as Node)) {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            setMenuOpen(false);
            setTocOpen(false);
          }
        });
      }
    }
  };

  initMobileTopNav();
  document.addEventListener('astro:before-preparation', (event) => {
    const navigationId = startPendingNavigation(event.sourceElement);

    if (!navigationId) {
      return;
    }

    const loadPage = event.loader;

    event.loader = async () => {
      try {
        await loadPage();

        if (event.signal.aborted) {
          clearPendingNavigation(navigationId);
        }
      } catch (error) {
        clearPendingNavigation(navigationId);
        throw error;
      }
    };
  });
  document.addEventListener('astro:after-swap', () => clearPendingNavigation());
  document.addEventListener('astro:page-load', initMobileTopNav);
</script>

<style>
  /*
    Static header in the page column (stevedylan.dev):
    +-----------------------------------------+
    | Name                        [gh][☾][⌕]  |
    | /blog    /about   ...                    |
    +-----------------------------------------+
  */
  .blog-top-nav {
    position: relative;
    z-index: 50;
    display: grid;
    grid-template-areas:
      'brand actions'
      'nav nav';
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    width: min(calc(100% - 32px), var(--layout-column, 768px));
    margin: 0 auto;
    padding: 64px 0 56px;
    font-size: var(--text-compact, 0.875rem);
    line-height: var(--leading-compact, 1.43);
  }

  .blog-top-nav::after {
    position: absolute;
    right: 0;
    bottom: 40px;
    left: 0;
    height: 2px;
    background: var(--paper-accent);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left;
  }

  .blog-top-nav[data-nav-pending='true'] {
    cursor: progress;
  }

  .blog-top-nav[data-nav-pending='true']::after {
    animation: nav-route-progress 900ms ease-in-out infinite;
    opacity: 1;
  }

  /* Links always visible as a grid, so no hamburger menu */
  .mobile-menu-toggle,
  .mobile-menu-panel,
  .mobile-toc-panel {
    display: none;
  }

  .brand,
  a.nav-link,
  .mobile-toc-panel a {
    color: var(--paper-ink);
    text-decoration: none;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    min-width: 0;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.2;
  }

  /* Name only; route shows as the active link instead */
  .brand-mark,
  .brand-route {
    display: none;
  }

  .brand:hover {
    text-decoration: underline;
  }

  .nav-links {
    grid-area: nav;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px 0;
  }

  a.nav-link:hover,
  a.nav-link.active,
  a.nav-link[data-nav-link-pending] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a.nav-link.active {
    color: var(--paper-accent);
  }

  .nav-link[data-nav-link-pending] {
    animation: nav-pending-pulse 620ms ease-in-out infinite alternate;
  }

  .nav-link-placeholder {
    color: var(--paper-ink-faint);
    cursor: default;
  }

  .nav-actions {
    grid-area: actions;
    display: flex;
    gap: 2px;
  }

  .nav-actions a,
  .nav-actions button {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--paper-ink-soft);
    cursor: pointer;
  }

  .nav-actions .toc-action {
    display: none;
  }

  /* Search trigger is styled by SiteSearch; flatten it to match the icons */
  .nav-actions :global(.site-search-trigger) {
    width: 34px;
    height: 34px;
    border: 0;
    background: none;
    color: var(--paper-ink-soft);
  }

  .nav-actions a:hover,
  .nav-actions button:hover,
  .nav-actions :global(.site-search-trigger:hover) {
    background: none;
    color: var(--paper-accent);
  }

  @media (max-width: 720px) {
    .blog-top-nav {
      width: calc(100% - 36px);
    }

    .brand {
      font-size: 1.25rem;
    }

    .brand-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nav-actions .toc-action {
      display: inline-grid;
    }

    .mobile-toc-panel {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      display: grid;
      width: min(300px, calc(100vw - 20px));
      max-height: min(52vh, 420px);
      gap: 8px;
      overflow: auto;
      padding: 10px;
      border: 1px solid var(--paper-line);
      border-radius: 8px;
      background: var(--paper-nav);
      box-shadow: var(--paper-shadow);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
      transition:
        opacity 160ms ease,
        transform 160ms ease;
    }

    .blog-top-nav[data-mobile-toc-open='true'] .mobile-toc-panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-toc-panel p {
      margin: 0;
      padding: 2px 2px 4px;
      color: var(--paper-ink-faint);
      font-family: var(--font-ui-label);
      font-size: 0.72rem;
      font-weight: 700;
      line-height: 1.2;
      text-transform: uppercase;
    }
  }

  @media (min-width: 721px) {
    .brand-route {
      display: none;
    }

    .nav-actions .toc-action {
      display: none;
    }
  }

  @keyframes nav-route-progress {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }

    12% {
      opacity: 1;
    }

    72% {
      opacity: 1;
      transform: scaleX(1);
    }

    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }

  @keyframes nav-pending-pulse {
    from {
      opacity: 0.42;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-top-nav[data-nav-pending='true']::after {
      animation: none;
      opacity: 1;
      transform: scaleX(1);
    }

    .nav-link[data-nav-link-pending] {
      animation: none;
    }
  }
</style>
